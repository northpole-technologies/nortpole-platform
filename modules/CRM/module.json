{
    "name": "CRM",
    "slug": "crm",
    "version": "1.0.0",
    "description": "Customer relationship management for organisations, contacts, notes, tasks and activities.",
    "enabled": true,
    "dependencies": [],
    "provider": "Modules\\CRM\\Providers\\CRMServiceProvider",
    "routes": {
        "api": "routes/api.php",
        "web": "routes/web.php"
    },
    "migrations": "database/migrations",
    "views": "resources/views",
    "config": {},
    "permissions": [
        "crm.customers.view",
        "crm.customers.create",
        "crm.customers.update",
        "crm.customers.delete"
    ],
    "roles": [
        {
            "key": "sales",
            "name": "Sales",
            "description": "Sales team members with access to customer and stock operations.",
            "permissions": [
                "crm.customers.view",
                "crm.customers.create",
                "crm.customers.update"
            ]
        }
    ],
    "navigation": [
        {
            "label": "Customers",
            "route": "crm.customers.index",
            "icon": "users",
            "permission": "crm.customers.view",
            "group": "CRM",
            "order": 10
        }
    ],
    "capabilities": [
        "customers",
        "contacts",
        "notes",
        "tasks",
        "activities"
    ],
    "events": {
        "publishes": [
            "crm.customer.created"
        ]
    },
    "commands": {
        "handles": {
            "crm.customer.create": "Modules\\CRM\\Commands\\CreateCustomerHandler"
        }
    },
    "queries": {
        "handles": {
            "crm.customer.list": "Modules\\CRM\\Queries\\ListCustomersHandler",
            "crm.customer.find": "Modules\\CRM\\Queries\\FindCustomerHandler"
        }
    }
}
